{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash

# Logs gh in to GitHub and, on personal machines, tea in to Forgejo and installs
# the SSH commit signing key, so HTTPS git, the gh/tea CLIs, and signed commits
# work as soon as chezmoi apply finishes. ~/.config/git/config already points git
# at gh and tea as credential helpers and at the signing key.
# Personal machines read everything from Bitwarden with a single unlock; other
# machines (no NetBird, so no Vaultwarden) use gh's browser login instead.

{{ template "common.sh" . }}
{{ template "bitwarden.sh" . }}
LOG_FILE="$LOG_DIR/run_onchange_after_07-login-git-forges.log"
PERSONAL={{ .personal }}
BW_SERVER="https://vault.lct.st"
GITHUB_HOST="github.com"
GITHUB_BW_ITEM="github.com access token"
FORGEJO_URL="https://git.lct.st"
FORGEJO_BW_ITEM="git.lct.st access token"
TEA_LOGIN_NAME="git.lct.st"
SIGNING_BW_ITEM="lutvzn git signing key"
SIGNING_KEY="$HOME/.ssh/git_signing_ed25519"
ALLOWED_SIGNERS="$HOME/.ssh/allowed_signers"

# Checks the stored gh token against the GitHub API.
github_login_works() {
  "$GH_BIN" api --hostname "$GITHUB_HOST" user --jq .login >/dev/null 2>&1
}

# Checks the token git will receive from tea against the Forgejo API.
# The header goes through stdin so the token never appears in the process list.
tea_login_works() {
  local token

  token="$(printf 'protocol=https\nhost=%s\n\n' "${FORGEJO_URL#https://}" \
    | "$TEA_BIN" login helper get 2>/dev/null | sed -n 's/^password=//p')"
  [ -n "$token" ] \
    && printf 'Authorization: token %s\n' "$token" \
      | curl -fsS -o /dev/null -H @- "$FORGEJO_URL/api/v1/user"
}

# Checks that the signing key, its public half, and the allowed signers entry
# exist and belong together.
signing_key_ready() {
  local public

  [ -s "$SIGNING_KEY" ] && [ -s "$SIGNING_KEY.pub" ] && [ -s "$ALLOWED_SIGNERS" ] || return 1
  public="$(cut -d' ' -f1,2 "$SIGNING_KEY.pub")"
  [ "$(ssh-keygen -y -P '' -f "$SIGNING_KEY" 2>/dev/null | cut -d' ' -f1,2)" = "$public" ] \
    && grep -qF "$public" "$ALLOWED_SIGNERS"
}

source_brew_environment || true

REQUIRED_COMMANDS=(git gh)
[ "$PERSONAL" = true ] && REQUIRED_COMMANDS+=(curl tea bw jq ssh-keygen)
for command in "${REQUIRED_COMMANDS[@]}"; do
  if ! command -v "$command" >/dev/null 2>&1; then
    log_message "ERROR: $command is not installed or not available in PATH."
    exit 1
  fi
done

GH_BIN="$(command -v gh)"
TEA_BIN="$(command -v tea || true)"

GITHUB_NEEDED=false
FORGEJO_NEEDED=false
SIGNING_NEEDED=false

if github_login_works; then
  log_message "INFO: gh is already logged in to $GITHUB_HOST."
else
  GITHUB_NEEDED=true
fi

if [ "$PERSONAL" = true ]; then
  if tea_login_works; then
    log_message "INFO: tea is already logged in to $FORGEJO_URL."
  else
    FORGEJO_NEEDED=true
  fi

  if signing_key_ready; then
    log_message "INFO: The SSH signing key is already installed at $SIGNING_KEY."
  else
    SIGNING_NEEDED=true
  fi
fi

[ "$GITHUB_NEEDED" = false ] && [ "$FORGEJO_NEEDED" = false ] \
  && [ "$SIGNING_NEEDED" = false ] && exit 0

# Not GITHUB_TOKEN/GH_TOKEN: gh reads those from the environment.
GH_LOGIN_TOKEN=""
FORGEJO_TOKEN=""
SIGNING_ITEM=""

if [ "$PERSONAL" = true ]; then
  bitwarden_unlock "$BW_SERVER" || exit 1
  [ "$GITHUB_NEEDED" = true ] && GH_LOGIN_TOKEN="$(bitwarden_password "$GITHUB_BW_ITEM")"
  [ "$FORGEJO_NEEDED" = true ] && FORGEJO_TOKEN="$(bitwarden_password "$FORGEJO_BW_ITEM")"
  [ "$SIGNING_NEEDED" = true ] && SIGNING_ITEM="$(bitwarden_item "$SIGNING_BW_ITEM")"
  bitwarden_lock
fi

STATUS=0

if [ "$GITHUB_NEEDED" = true ]; then
  if [ -n "$GH_LOGIN_TOKEN" ]; then
    # Passed through stdin so the token never appears in the process list.
    printf '%s\n' "$GH_LOGIN_TOKEN" \
      | "$GH_BIN" auth login --hostname "$GITHUB_HOST" --git-protocol https --with-token
  elif [ -t 0 ]; then
    [ "$PERSONAL" = true ] \
      && log_message "INFO: Bitwarden item '$GITHUB_BW_ITEM' not found; falling back to the browser login."
    "$GH_BIN" auth login --hostname "$GITHUB_HOST" --git-protocol https --web --skip-ssh-key </dev/tty
  else
    log_message "INFO: No terminal for the GitHub browser login; run 'gh auth login' manually."
  fi
  GH_LOGIN_TOKEN=""

  if github_login_works; then
    log_message "SUCCESS: gh is logged in to $GITHUB_HOST as $("$GH_BIN" api --hostname "$GITHUB_HOST" user --jq .login)."
  elif [ "$PERSONAL" = true ] || [ -t 0 ]; then
    log_message "ERROR: gh could not log in to $GITHUB_HOST."
    STATUS=1
  fi
fi

if [ "$FORGEJO_NEEDED" = true ]; then
  # A stale login (revoked token) would block re-adding it under the same name.
  "$TEA_BIN" login delete "$TEA_LOGIN_NAME" >/dev/null 2>&1 || true

  if [ -z "$FORGEJO_TOKEN" ]; then
    log_message "ERROR: Could not read the password of Bitwarden item '$FORGEJO_BW_ITEM'."
    STATUS=1
  # Passed through the environment so the token never appears in the process list.
  elif GITEA_SERVER_TOKEN="$FORGEJO_TOKEN" "$TEA_BIN" login add \
    --name "$TEA_LOGIN_NAME" --url "$FORGEJO_URL" >/dev/null \
    && tea_login_works; then
    log_message "SUCCESS: tea is logged in to $FORGEJO_URL as $("$TEA_BIN" login list --output csv | awk -F, -v name="$TEA_LOGIN_NAME" '$1 == name { print $4 }')."
  else
    log_message "ERROR: tea could not log in to $FORGEJO_URL with the token from '$FORGEJO_BW_ITEM'."
    STATUS=1
  fi
  FORGEJO_TOKEN=""
fi

if [ "$SIGNING_NEEDED" = true ]; then
  GIT_EMAIL="$(git config --get user.email)"
  SIGNING_PUBLIC="$(printf '%s' "$SIGNING_ITEM" | jq -r '.sshKey.publicKey // empty' 2>/dev/null | cut -d' ' -f1,2)"

  if [ -z "$SIGNING_PUBLIC" ]; then
    log_message "ERROR: Could not read the SSH key of Bitwarden item '$SIGNING_BW_ITEM'."
    STATUS=1
  elif [ -z "$GIT_EMAIL" ]; then
    log_message "ERROR: git has no user.email to put in $ALLOWED_SIGNERS."
    STATUS=1
  else
    mkdir -p "$(dirname "$SIGNING_KEY")"
    chmod 700 "$(dirname "$SIGNING_KEY")"
    (umask 077 && printf '%s' "$SIGNING_ITEM" | jq -r '.sshKey.privateKey' >"$SIGNING_KEY")
    chmod 600 "$SIGNING_KEY"
    printf '%s\n' "$SIGNING_PUBLIC" >"$SIGNING_KEY.pub"
    printf '%s namespaces="git" %s\n' "$GIT_EMAIL" "$SIGNING_PUBLIC" >"$ALLOWED_SIGNERS"

    if signing_key_ready; then
      log_message "SUCCESS: Installed the SSH signing key $(ssh-keygen -l -f "$SIGNING_KEY.pub" | cut -d' ' -f2) at $SIGNING_KEY."
    else
      log_message "ERROR: The key in Bitwarden item '$SIGNING_BW_ITEM' is not a usable unencrypted SSH key."
      STATUS=1
    fi
  fi
  SIGNING_ITEM=""
fi

exit "$STATUS"
{{ end -}}

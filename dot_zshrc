# .zshrc - Organized & Minimalist (Adapted from .bashrc)

# -----------------------------------------------------------------------------
# 1. Global Definitions & Non-Interactive Check
# -----------------------------------------------------------------------------

# If not running interactively, don't do anything else
[[ -o interactive ]] || return

# Initialize Homebrew when available
for BREW_BIN in /home/linuxbrew/.linuxbrew/bin/brew /opt/homebrew/bin/brew /usr/local/bin/brew; do
  if [ -x "$BREW_BIN" ]; then
    eval "$("$BREW_BIN" shellenv)"
    break
  fi
done
unset BREW_BIN

# -----------------------------------------------------------------------------
# 2. Environment & PATH
# -----------------------------------------------------------------------------

# Prepend user bin directories
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

# Cargo / Rust environment
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# -----------------------------------------------------------------------------
# 3. Zim Shell Modules
# -----------------------------------------------------------------------------

ZIM_HOME=${ZIM_HOME:-${XDG_CACHE_HOME:-${HOME}/.cache}/zim}
ZIMFW_SCRIPT=""
if [[ -n "${HOMEBREW_PREFIX:-}" && -f "$HOMEBREW_PREFIX/share/zimfw/zimfw.zsh" ]]; then
  ZIMFW_SCRIPT="$HOMEBREW_PREFIX/share/zimfw/zimfw.zsh"
elif [[ -f "${ZDOTDIR:-$HOME}/.zim/zimfw.zsh" ]]; then
  ZIMFW_SCRIPT="${ZDOTDIR:-$HOME}/.zim/zimfw.zsh"
fi
if [[ -n "$ZIMFW_SCRIPT" ]]; then
  if [[ ! -e ${ZIM_HOME}/init.zsh ]]; then
    source "$ZIMFW_SCRIPT" install
  fi
  source ${ZIM_HOME}/init.zsh
fi
unset ZIMFW_SCRIPT

# -----------------------------------------------------------------------------
# 4. Prompt Customization (Fallback)
# -----------------------------------------------------------------------------

# This serves as a clean backup prompt.
# If tools like starship are initialized below, they will override this.
PROMPT='%F{green}%n@%m%f %F{cyan}%~%f
%F{green}❯%f '

# -----------------------------------------------------------------------------
# 5. Tool Initialization
# -----------------------------------------------------------------------------

# Generic tool init (only if the command exists)
[ "$(command -v zoxide)" ] && eval "$(zoxide init zsh)"
[ "$(command -v starship)" ] && eval "$(starship init zsh)"
[ "$(command -v atuin)" ] && eval "$(atuin init zsh)"
[ "$(command -v fzf)" ] && source <(fzf --zsh)
[ "$(command -v fnm)" ] && eval "$(fnm env --use-on-cd --shell zsh)"

# Use Bash/readline-style line editing and make navigation keys consistent
# across terminals.
bindkey -e
zmodload -F zsh/terminfo +p:terminfo 2>/dev/null

[[ -n ${terminfo[khome]-} ]] && bindkey "${terminfo[khome]}" beginning-of-line
[[ -n ${terminfo[kend]-} ]] && bindkey "${terminfo[kend]}" end-of-line
[[ -n ${terminfo[kdch1]-} ]] && bindkey "${terminfo[kdch1]}" delete-char

# Common xterm, Linux console, and application-mode key sequences.
for key in '^[[H' '^[[1~' '^[OH'; do bindkey "$key" beginning-of-line; done
for key in '^[[F' '^[[4~' '^[OF'; do bindkey "$key" end-of-line; done
bindkey '^[[3~' delete-char
bindkey '^[[1;5D' backward-word
bindkey '^[[1;5C' forward-word
bindkey '^[[3;5~' kill-word
bindkey '^?' backward-delete-char
unset key

# Keep standard zsh completion on Tab. fzf's init can override it.
bindkey '^I' expand-or-complete

# Preserve fzf completion on Ctrl-F instead of Tab.
bindkey '^F' fzf-completion

# -----------------------------------------------------------------------------
# 6. Zellij Autostart
# -----------------------------------------------------------------------------

# Attach SSH logins to a persistent, predictably named session. Keep Zellij's
# standard auto-start behavior for local terminals and avoid nested sessions.
if [[ -t 0 && -t 1 && -z "${ZELLIJ:-}" ]] && command -v zellij &>/dev/null; then
  if [[ -n "${SSH_CONNECTION:-}" ]]; then
    exec zellij attach --create ssh
  else
    eval "$(zellij setup --generate-auto-start zsh)"
  fi
fi

# -----------------------------------------------------------------------------
# 7. Aliases & Functions
# -----------------------------------------------------------------------------

# Modern replacements (eza for ls, ug for grep)
if command -v eza &>/dev/null; then
  alias ls='eza'
  alias ll='eza -l --icons=auto --group-directories-first'
  alias l.='eza -d .*'
  alias l1='eza -1'
fi

if command -v ug &>/dev/null; then
  alias grep='ug'
  alias egrep='ug -E'
  alias fgrep='ug -F'
fi

# Source custom scripts and external alias files
[ -f ~/.config/aliases ] && . ~/.config/aliases

if [ -d ~/.zshrc.d ]; then
  for rc in ~/.zshrc.d/*; do
    [ -f "$rc" ] && . "$rc"
  done
  unset rc
fi

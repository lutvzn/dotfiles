{{ if and (eq .chezmoi.os "linux") .personal -}}
#!/bin/bash

# lutvzn itself is created and kept at 5997:5997 by run_before_00-0-check-lutvzn-ids.

{{ template "common.sh" . }}
LOG_FILE="$LOG_DIR/run_onchange_after_02-setup-users.log"
TARGET_USER="lutvzn"

configure_login_shell() {
  local shell_path

  shell_path="$(PATH="$PRIVILEGED_PATH" command -v zsh)" || shell_path="/bin/bash"

  if [ "$shell_path" != "/bin/bash" ] && ! grep -qxF "$shell_path" /etc/shells 2>/dev/null; then
    echo "$shell_path" | run_with_sudo tee -a /etc/shells >/dev/null
  fi

  if [ "$(getent passwd "$TARGET_USER" | cut -d: -f7)" != "$shell_path" ]; then
    run_with_sudo usermod -s "$shell_path" "$TARGET_USER" || {
      log_message "ERROR: Failed to set the login shell of $TARGET_USER to $shell_path."
      exit 1
    }
  fi
}

configure_home() {
  local home_dir

  home_dir="$(getent passwd "$TARGET_USER" | cut -d: -f6)"

  if run_with_sudo chown "$TARGET_USER:$TARGET_USER" "$home_dir" \
    && run_with_sudo chmod 0700 "$home_dir"; then
    return
  fi

  log_message "ERROR: Failed to configure the home directory of $TARGET_USER."
  exit 1
}

log_message "INFO: Configuring users."
configure_login_shell
configure_home
log_message "SUCCESS: Users configured."
{{ end -}}

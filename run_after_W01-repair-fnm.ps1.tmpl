{{ if and (eq .chezmoi.os "windows") (has "update" .chezmoi.args) -}}
# Run on every chezmoi update, but not on apply or PowerShell startup.
# Ordered after Winget provisioning and before Pi setup.
$ErrorActionPreference = 'Stop'
{{ template "refresh-path.ps1" . }}
. (Join-Path $HOME '.config/personalScripts/Repair-Fnm.ps1')
Repair-Fnm -Default
{{ end -}}
